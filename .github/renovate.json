{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":gomod"
  ],
  "postUpdateOptions": [
    "gomodUpdateImportPaths",
    "gomodTidy1.17"
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchPackageNames": ["code.cloudfoundry.org/guardian"],
      "overridePackageName": "github.com/cloudfoundry/garden-runc-release/src/code.cloudfoundry.org/guardian"
    }
  ]
}
